# SecureGate Environment Configuration
# Copy this file to .env and configure secrets as needed

# Flask Server Configuration
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=1
SECRET_KEY=securegate-hackathon-secret-key-change-in-production
DATABASE_URL=sqlite:///securegate.db

# Target Configuration (Local Deliberately Vulnerable Apps Only)
TARGET_URL=http://localhost:3000
JUICE_SHOP_PORT=3000

# Optional: OpenAI API Key for AI Security Analyst
# If unset, SecureGate uses its high-quality deterministic security advisory engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DevSecOps Release Gate Thresholds (Default Policy)
GATE_CRITICAL=BLOCK
GATE_HIGH=BLOCK
GATE_MEDIUM=REVIEW
GATE_LOW=PASS
GATE_INFORMATIONAL=PASS
